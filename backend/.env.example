# Copie este arquivo para backend/.env apenas no ambiente local.
# No Railway, configure os mesmos nomes em Variables para API e Worker.
# Nunca publique valores reais nem envie segredos ao Vite/frontend.

# Use a URL privada do serviço PostgreSQL do Railway.
# Localmente pode usar: sqlite:///social_listening.db
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/railway

# Gere uma chave longa aleatória; usada para assinar sessões JWT.
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA

# Credenciais de acesso ao painel.
ADMIN_USER=admin
# Gere com bcrypt; não coloque a senha em texto puro neste campo.
ADMIN_PASSWORD_HASH=COLE_AQUI_O_HASH_BCRYPT_DA_SENHA

# Bearer token da X API v2; necessário para o Worker executar coletas.
X_BEARER_TOKEN=COLE_AQUI_O_BEARER_TOKEN_DA_X_API

# Instagram: token de longa duração da conta profissional (Graph API); necessário no Worker.
INSTAGRAM_ACCESS_TOKEN=COLE_AQUI_O_TOKEN_DO_INSTAGRAM
# Token do "Instagram Login": https://graph.instagram.com/v25.0
# Token do "Facebook Login": https://graph.facebook.com/v25.0 (e informe INSTAGRAM_USER_ID)
INSTAGRAM_API_BASE=https://graph.instagram.com/v25.0
INSTAGRAM_USER_ID=me
INSTAGRAM_CAPTURE_MAX_COMMENTS=5000

# Parâmetros de estimativa de consumo.
MONTHLY_BUDGET_USD=50
POST_PRICE_USD=0.005
ALERT_THRESHOLDS=70,85,95

# Origem pública exata do frontend em produção, sem barra final.
# Exemplo: https://meu-frontend.up.railway.app
CORS_ORIGIN=http://localhost:5173
